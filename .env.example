# Copy to `.env`, which is gitignored.
#
# Only `bun run deploy` reads this, and only to know where to ship. Nothing
# secret belongs here: there is no key to production in this repo or in
# GitHub, because deploying happens from a laptop that already has your SSH
# agent. The server's own secrets — the OAuth2 client ids, anything else the
# API needs — live in /srv/whistleday/.env on the box and never leave it.

# The server. An IP until DNS has propagated, then the domain.
WHISTLEDAY_HOST=whistle.day

# The account `bootstrap.sh` made. It can restart the two services and nothing
# else; it is deliberately not the account that owns the database.
WHISTLEDAY_DEPLOY_USER=deploy

# Which branch a release has to be on. `bun run deploy` refuses to ship a
# commit that is not on it, so that what is running is always something
# somebody else can check out.
WHISTLEDAY_BRANCH=master
